{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SpinLab",
  "version": "0.1.1",
  "identifier": "com.spinlab.dj",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SpinLab DJ",
        "width": 1500,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "dragDropEnabled": true,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERDN0Q2MTZFNzQ3N0RFNUMKUldSYzNuZDBibUY5M0RESFNydWJsOVRsRkprUzE0Z29tVXRVZWpqSWZFWThnOTJIMzlkR3FXMkkK",
      "endpoints": [
        "https://www.djtrombetta.it/server/updates/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
