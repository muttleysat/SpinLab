{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SpinLab",
  "version": "0.1.0",
  "identifier": "com.spinlab.dj",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "title": "SpinLab DJ", "width": 1500, "height": 900, "minWidth": 1100, "minHeight": 700, "dragDropEnabled": true }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
